{
    "name": "absolutoffice/taxid",
    "description": "Modular tax identification validation and lookup library.",
    "type": "library",
    "license": "LGPL-3.0-only",
    "autoload": {
        "psr-4": {
            "TaxId\\": "src/TaxId/"
        }
    },
    "require": {
        "php": ">=8.4.27 <8.5 || >=8.5.12 <8.6",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpdocumentor/shim": "^3.10",
        "squizlabs/php_codesniffer": "^4.0",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "config": {
        "allow-plugins": {
            "phpdocumentor/shim": true
        },
        "platform": {
            "php": "8.4.27"
        }
    }
}
